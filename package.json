{
  "name": "spatialchat",
  "version": "1.0.0",
  "private": true,
  "description": "SpatialChat - secure private messaging platform",
  "license": "MIT",
  "workspaces": ["backend", "frontend"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w backend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "test": "npm run test -w backend",
    "test:e2e": "npm run test:e2e -w frontend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:deploy": "npm run db:deploy -w backend",
    "db:seed": "npm run db:seed -w backend",
    "audit": "npm audit --omit=dev"
  },
  "devDependencies": { "concurrently": "^9.1.0" }
}
