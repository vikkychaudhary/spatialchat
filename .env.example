# Copy to .env (never commit .env). Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://spatialchat:spatialchat@localhost:5432/spatialchat?schema=public
# Used by automated tests only (database created by docker/initdb)
TEST_DATABASE_URL=postgresql://spatialchat:spatialchat@localhost:5432/spatialchat_test?schema=public

# >= 32 chars. Keys the HMAC that hashes session and reset tokens.
SESSION_SECRET=change-me-dev-only-0123456789abcdef0123456789abcdef

# Comma-separated list of exact browser origins allowed for CORS, CSRF origin checks and WebSockets.
CLIENT_ORIGINS=http://localhost:5173
# Public base URL of the web app (used in password-reset links).
APP_URL=http://localhost:5173

# Optional. Defaults to true in production, false otherwise.
# COOKIE_SECURE=true
# Number of reverse proxies in front of the API (1 for nginx/Caddy/most PaaS).
TRUST_PROXY=0
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=72

# Email (password reset). Local default: Mailpit from docker-compose (UI at http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=SpatialChat <no-reply@spatialchat.local>

# Development/e2e only. The server refuses to start in production with this set to true.
DISABLE_RATE_LIMITS=false
